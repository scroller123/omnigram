# Go Backend API Configuration
API_ID=
API_HASH=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegai?sslmode=disable
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Security/Auth Configuration
# 64 hex characters (32 bytes) for AES-256 session encryption
# You can generate a valid ENCRYPTION_SECRET by running: openssl rand -hex 32 in your terminal.
ENCRYPTION_SECRET=
# Secret for signing JWT tokens
JWT_SECRET=

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=omniram
CURRENT_USER=0:0
DOCKER_GROUP=0
